APP_NAME="ESG Data Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.org
APP_TIMEZONE=Asia/Dhaka

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Production: MySQL/MariaDB. For local demo use DB_CONNECTION=sqlite and DB_DATABASE blank.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=esg_data_platform
DB_USERNAME=esg_data_platform
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

REMINDER_OFFSETS=14,3,0
